{
  "name": "pdf-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-spa-fallback.mjs && node scripts/deploy-output-check.mjs /",
    "build:subpath": "vite build --base=/zenid/ && node scripts/prepare-spa-fallback.mjs && node scripts/deploy-output-check.mjs /zenid/",
    "lint": "oxlint",
    "test": "node --test src/*.test.js src/resume/*.test.js src/portfolio/*.test.js src/host/*.test.js",
    "test:e2e": "playwright test",
    "benchmark:project-import": "playwright test --config=playwright.benchmark.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.25.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
